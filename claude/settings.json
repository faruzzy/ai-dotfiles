{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CCGUI_CLI_LOGIN_AUTHORIZED": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cd * && git *)"
    ]
  },
  "enabledPlugins": {
    "superlearn@superlearn-marketplace": true,
    "frontend-design@claude-plugins-official": true,
    "azure@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superlearn-marketplace": {
      "source": {
        "source": "github",
        "repo": "raiyanyahya/superlearn"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status waiting 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status working 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status working 2>/dev/null || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status working 2>/dev/null || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status waiting 2>/dev/null || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status waiting 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status waiting 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-tmux-status clear 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
